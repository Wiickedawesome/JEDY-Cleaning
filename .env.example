# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://jedycleaning.us
NEXT_PUBLIC_SITE_NAME=JEDY Cleaning

# Email Configuration (for contact form - optional)
# NEXT_PUBLIC_RESEND_API_KEY=your_resend_key_here
# NEXT_PUBLIC_EMAIL_TO=mom@jedycleaning.us

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-ZNVLK51L9M

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
