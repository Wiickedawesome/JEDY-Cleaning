# Environment Variables Template
# Copy this file to .env.local and fill in your values.

# Search engine verification tokens, read at build time by app/layout.tsx.
# Production builds currently omit both, so verification (if configured) is DNS-based.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact-form delivery (Web3Forms). Public by design and inlined at build time,
# so it must be present when `npm run build` runs. Without it the form shows the
# phone/email fallback instead of submitting.
NEXT_PUBLIC_WEB3FORMS_KEY=
