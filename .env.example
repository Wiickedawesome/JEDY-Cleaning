# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://icy-forest-0159f671e.3.azurestaticapps.net
NEXT_PUBLIC_SITE_NAME=JEDY Cleaning

# Email Configuration (for contact form - optional)
# NEXT_PUBLIC_RESEND_API_KEY=your_resend_key_here
# NEXT_PUBLIC_EMAIL_TO=mom@jedycleaning.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
