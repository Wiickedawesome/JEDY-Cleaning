{
  "build": {
    "appLocation": "/",
    "outputLocation": ".next",
    "appBuildCommand": "npm run build"
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated", "anonymous"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html"
  },
  "env": "production"
}
